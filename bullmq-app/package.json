{
	"name": "dam-bullmq-app",
	"version": "1.0.0",
	"description": "Standalone Bull MQ application for DAM backend",
	"main": "dist/index.js",
	"scripts": {
		"dev": "nodemon -r tsconfig-paths/register ./src/index.ts",
		"start": "node dist/index.js",
		"build": "npx tsc -p tsconfig.json && npx tsc-alias -p tsconfig.json",
		"clean": "rm -rf dist"
	},
	"dependencies": {
		"bullmq": "^5.58.5",
		"ioredis": "^5.7.0",
		"winston": "^3.17.0",
		"dotenv": "^17.2.1"
	},
	"devDependencies": {
		"@types/node": "^24.3.0",
		"nodemon": "^3.1.0",
		"ts-node": "^10.9.2",
		"tsconfig-paths": "^4.2.0",
		"tsc-alias": "^1.8.16",
		"typescript": "^5.9.2"
	}
}
