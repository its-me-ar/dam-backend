{
	"name": "image-worker-app",
	"version": "1.0.0",
	"description": "Image processing worker application for DAM backend",
	"main": "dist/index.js",
	"scripts": {
		"setup": "node scripts/setup-dependencies.js",
		"predev": "npm run setup",
		"dev": "nodemon -r tsconfig-paths/register ./src/index.ts",
		"prebuild": "npm run setup",
		"build": "npx tsc -p tsconfig.json && npx tsc-alias -p tsconfig.json && npm run setup",
		"build:docker": "npx tsc -p tsconfig.json && npx tsc-alias -p tsconfig.json",
		"prestart": "npm run setup",
		"start": "node dist/index.js > logs/worker.log 2>&1",
		"start:docker": "node dist/index.js",
		"start:dev": "node dist/index.js",
		"start:foreground": "node dist/index.js",
		"clean": "rm -rf dist generated logs",
		"logs": "tail -f logs/worker.log",
		"logs:error": "tail -f logs/error.log",
		"prisma:generate": "cd ../prisma && npx prisma generate"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.879.0",
		"@aws-sdk/s3-request-presigner": "^3.879.0",
		"@prisma/client": "^6.15.0",
		"axios": "^1.11.0",
		"bullmq": "^5.58.5",
		"dotenv": "^17.2.1",
		"ioredis": "^5.7.0",
		"sharp": "^0.33.5",
		"tsc-alias": "^1.8.16",
		"winston": "^3.17.0"
	},
	"devDependencies": {
		"@types/node": "^24.3.0",
		"@types/sharp": "^0.32.0",
		"nodemon": "^3.1.0",
		"prisma": "^6.15.0",
		"ts-node": "^10.9.2",
		"tsconfig-paths": "^4.2.0",
		"typescript": "^5.9.2"
	},
	"keywords": ["image", "processing", "worker", "dam", "sharp"],
	"author": "DAM Backend Team",
	"license": "MIT"
}
